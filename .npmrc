# Supply-chain safety (docs/progress/2026-10-24-*.md). No package runs its own install script; the
# build needs none. Versions are saved exact, and npm refuses any published less than 14 days ago
# (the project's two-week rule, now enforced). npm ci installs from the lockfile only.
ignore-scripts=true
save-exact=true
min-release-age=14
